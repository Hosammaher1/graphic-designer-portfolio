; Install as a dedicated PHP-FPM pool after checking the host's PHP version.
[portfolio]
user = www-data
group = www-data
listen = /run/php/portfolio.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = dynamic
pm.max_children = 4
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
chdir = /
clear_env = yes
security.limit_extensions = .php
php_admin_value[expose_php] = Off
